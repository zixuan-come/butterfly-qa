# Optional host port for the Butterfly QA web service.
# Keep the container port at 8000.
BUTTERFLY_QA_PORT=8000

# Host Codex login used by the Agent runtime inside Docker.
# Use forward slashes on Windows.
CODEX_AUTH_FILE=C:/Users/your-name/.codex/auth.json
CODEX_CONFIG_FILE=C:/Users/your-name/.codex/config.toml
